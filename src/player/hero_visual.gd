## The hero's cutout rig (ADR-0005, art bible §5.5-5.7): Skeleton2D + Bone2D, one
## rigid Sprite2D per slot part, AnimationPlayer poses. Reads the Player's state
## every frame and never writes it: gameplay timing stays in Player and its data;
## attack, roll and dash animations are SEEKED by their progress, so they always
## last exactly as long as the move does (any weapon speed, hitstop freezes them).
## Hitboxes stay in Player.strike_rect(); the smear here is only a picture.
##
## Slots (bible §5.7 table) are swapped with set_tier(slot, tier); the weapon in
## hand with set_weapon_sprite(). The scene is generated by
## tools/asset-pipeline/hero/build_hero.py (bones, slot sprites in z order, poses).
## `-- --hero-tier=N` dresses every slot in tier N (QA screenshots).
class_name HeroVisual
extends Node2D

const ART_DIR: String = "res://assets/art/hero/"
## Height of the mannequin in the source art, px (bible §8: drawn at 2x).
const SOURCE_HEIGHT_PX: float = 320.0
## Slot -> sprite node names under Body/Parts.
const SLOT_PARTS: Dictionary = {
	"cape_back": ["cape_back_1", "cape_back_2", "cape_back_3"],
	"weapon_off": ["weapon_off"],
	"arm_far": ["arm_far_upper", "arm_far_fore", "arm_far_hand"],
	"leg_far": ["leg_far_thigh", "leg_far_shin", "leg_far_foot"],
	"body_base": ["body_base_torso", "body_base_pelvis"],
	"legs_cloth": ["legs_cloth_pelvis", "legs_cloth_thigh", "legs_cloth_shin"],
	"boots": ["boots_shin", "boots_foot"],
	"torso_cloth": ["torso_cloth"],
	"torso_armor": ["torso_armor"],
	"skirt": ["skirt"],
	"belt": ["belt"],
	"head_base": ["head_base"],
	"hair": ["hair"],
	"aventail": ["aventail"],
	"helmet": ["helmet"],
	"cape_front": ["cape_front"],
	"amulet": ["amulet"],
	"arm_near": ["arm_near_upper", "arm_near_fore", "arm_near_hand"],
}
## Slots with one picture on every tier (the mannequin).
const FIXED_SLOTS: Array[String] = ["body_base", "head_base"]
## A helmet of this tier or higher hides the hair (bible §5.7 `hair`).
const HELMET_HIDES_HAIR: int = 3
const TIERS: int = 5
## Weapon textures point along +x; the grip (fist centre) sits this far from the
## left edge, vertically centred, unless set_weapon_sprite() gets another grip.
const DEFAULT_GRIP: Vector2 = Vector2(52, 26)
## Stick tip and smear base along the weapon, source px from the grip.
const WEAPON_TIP: float = 172.0
const SMEAR_BASE: float = 100.0
const SMEAR_SAMPLES: int = 8
const SMEAR_SPAN: float = 0.16
const SMEAR_COLOR: Color = Color("#FFE9B8")
const GLOW_COLOR: Color = Color("#FFC94A")
const GHOST_COLOR: Color = Color("#EDE6F2")
const HURT_TIME: float = 0.2
const FLASH_TIME: float = 1.0 / 30.0
const BLEND: float = 0.08
## Run animation length per stride cycle (bible §5.5: 0.5 s at full speed) and the
## Player's run phase rate divisor (player.gd: run_ph += dt * |vx| / 26).
const RUN_CYCLE_S: float = 0.5
const RUN_PH_DIV: float = 26.0

## Hero height on a 1080p screen, px (bible §5.1: 160).
@export var height_px: float = 160.0
## The hero this rig shows. Set before adding to the tree.
var player: Player
## slot -> tier currently shown.
var tiers: Dictionary = {}
## True while the red thread shows Mokosh silver (death, save, revive).
var thread_silver: bool = false

var _anim: AnimationPlayer
var _skel: Skeleton2D
var _body: CanvasGroup
var _parts: Node2D
var _smear: Node2D
var _fx: Node2D
var _glow: Sprite2D
var _mat: ShaderMaterial
var _cur: String = ""
var _hurt_t: float = 0.0
var _flash_t: float = 0.0
var _smear_pts: PackedVector2Array = PackedVector2Array()
var _cape: Array[float] = [0.0, 0.0, 0.0]
var _clock: float = 0.0

func _ready() -> void:
	_anim = $AnimationPlayer
	_skel = $Body/Skeleton2D
	_body = $Body
	_parts = $Body/Parts
	_smear = $Smear
	_fx = $Fx
	_glow = $Glow
	_mat = _body.material as ShaderMaterial
	_anim.callback_mode_process = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_MANUAL
	var zoom := Tune.f("camera_zoom") if Tune.data.has("camera_zoom") else 1.0
	_skel.scale = Vector2.ONE * height_px / zoom / SOURCE_HEIGHT_PX
	_smear.draw.connect(_draw_smear)
	# additive: the smear is light, never a grey sheet over the background
	var add := CanvasItemMaterial.new()
	add.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	_smear.material = add
	_fx.draw.connect(_draw_fx)
	var tier := 1
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--hero-tier="):
			tier = clampi(int(a.trim_prefix("--hero-tier=")), 1, TIERS)
	set_all_tiers(tier)
	if player:
		player.hurt_taken.connect(_on_hurt)
	_play("idle", 0.0)
	_anim.seek(0.0, true)

# ---------------- slots ----------------

## Path of a slot part's picture for `tier`, falling back to the nearest lower
## tier that exists; "" if none (the slot is empty at that tier).
static func part_path(part: String, slot: String, tier: int) -> String:
	if slot in FIXED_SLOTS:
		return ART_DIR + "char_hero_%s_01.svg" % part
	for t in range(tier, 0, -1):
		var p := ART_DIR + "char_hero_%s_t%d_01.svg" % [part, t]
		if ResourceLoader.exists(p):
			return p
	return ""

## Shows `slot` at `tier` (1..5): swaps the textures of its parts only. An empty
## tier hides the parts. A helmet of tier HELMET_HIDES_HAIR+ hides the hair.
func set_tier(slot: String, tier: int) -> void:
	if not SLOT_PARTS.has(slot):
		push_error("HeroVisual: unknown slot '%s'" % slot)
		return
	tiers[slot] = clampi(tier, 1, TIERS)
	for part: String in SLOT_PARTS[slot]:
		var s := _parts.get_node(part) as Sprite2D
		var p := part_path(part, slot, tiers[slot])
		s.texture = load(p) as Texture2D if p != "" else null
		s.visible = s.texture != null
	if slot == "helmet" or slot == "hair":
		_update_hair()

## Every slot at the same tier (weapon_off stays empty until an off-hand weapon).
func set_all_tiers(tier: int) -> void:
	for slot: String in SLOT_PARTS:
		if slot != "weapon_off":
			set_tier(slot, tier)
	(_parts.get_node("weapon_off") as Sprite2D).visible = false

func _update_hair() -> void:
	var hair := _parts.get_node("hair") as Sprite2D
	var helm := _parts.get_node("helmet") as Sprite2D
	if helm.visible and int(tiers.get("helmet", 1)) >= HELMET_HIDES_HAIR:
		hair.visible = false
	else:
		hair.visible = hair.texture != null

## Puts `tex` in the near hand. The texture points along +x; `grip` is the fist
## centre in texture px (default DEFAULT_GRIP).
func set_weapon_sprite(tex: Texture2D, grip: Vector2 = DEFAULT_GRIP) -> void:
	var s := _parts.get_node("weapon_main") as Sprite2D
	s.texture = tex
	s.offset = -grip
	s.visible = tex != null

## Red thread of Mokosh (bible §5.6 p.2) turns silver for save, death and revive.
func set_thread_silver(on: bool) -> void:
	thread_silver = on
	var p := ART_DIR + ("char_hero_thread_silver_01.svg" if on else "char_hero_thread_01.svg")
	(_parts.get_node("thread") as Sprite2D).texture = load(p) as Texture2D

# ---------------- choosing the animation ----------------

## The Player's state as plain values (pure input of choose()).
static func state_of(p: Player) -> Dictionary:
	return {
		"dead": p.dead, "flare_t": p.flare_t, "flare_dur": Tune.f("flare_windup") if p.flare_t > 0.0 else 1.0,
		"dash_t": p.dash_t, "dash_dur": p.dash_dur, "rolling": p.rolling,
		"atk_t": p.atk_t, "atk_dur": p.atk_dur, "atk_dir": p.atk_dir, "combo": p.combo,
		"on_floor": p.is_on_floor() if p.is_inside_tree() else true,
		"vx": p.velocity.x, "vy": p.velocity.y,
	}

## Picks the animation for a state: {anim, k} where k in 0..1 is the progress to
## seek to, or -1 for time-driven animations. Priority: death, Flare breath,
## dash/roll, strike, hurt, air, run, idle. `hurt_t` is the visual's hurt clock.
static func choose(s: Dictionary, hurt_t: float = 0.0) -> Dictionary:
	if bool(s.dead):
		return { "anim": "death", "k": -1.0 }
	if float(s.flare_t) > 0.0:
		return { "anim": "flare", "k": clampf(1.0 - float(s.flare_t) / maxf(float(s.flare_dur), 0.001), 0.0, 1.0) }
	if float(s.dash_t) > 0.0:
		var dk := clampf(1.0 - float(s.dash_t) / maxf(float(s.dash_dur), 0.001), 0.0, 1.0)
		return { "anim": "roll" if bool(s.rolling) else "dash", "k": dk }
	if float(s.atk_t) > 0.0:
		var k := clampf(1.0 - float(s.atk_t) / maxf(float(s.atk_dur), 0.001), 0.0, 1.0)
		match String(s.atk_dir):
			"up": return { "anim": "strike_up", "k": k }
			"down": return { "anim": "strike_down", "k": k }
		return { "anim": "strike_%d" % clampi(int(s.combo), 1, 3), "k": k }
	if hurt_t > 0.0:
		return { "anim": "hurt", "k": -1.0 }
	if not bool(s.on_floor):
		return { "anim": "jump" if float(s.vy) < 0.0 else "fall", "k": -1.0 }
	if absf(float(s.vx)) > 20.0:
		return { "anim": "run", "k": -1.0 }
	return { "anim": "idle", "k": -1.0 }

# ---------------- per frame ----------------

func _process(dt: float) -> void:
	if player == null:
		return
	var w := player.world
	var frozen := w != null and w.hitstop > 0.0
	var adt := 0.0 if frozen else dt * (w.time_mult() if w else 1.0)
	_hurt_t -= adt
	_flash_t -= dt
	_clock += adt
	var pick := choose(state_of(player), _hurt_t)
	var anim_name: String = pick.anim
	var k: float = pick.k
	if k >= 0.0:
		if anim_name != _cur:
			_play(anim_name, 0.0)
		var length := _anim.current_animation_length
		_sample_smear(anim_name, k, length)
		_anim.seek(k * length, true)
	else:
		if anim_name != _cur:
			_play(anim_name, 0.0 if anim_name in ["death", "hurt"] else BLEND)
		var rate := 1.0
		if anim_name == "run":
			rate = absf(player.velocity.x) / RUN_PH_DIV / TAU * RUN_CYCLE_S
		_anim.advance(adt * rate)
		_smear_pts.clear()
	if player.dead != thread_silver:
		set_thread_silver(player.dead)
	_apply_body()
	_apply_cape(adt)
	_apply_glow()
	_smear.queue_redraw()
	_fx.queue_redraw()

func _play(anim_name: String, blend: float) -> void:
	_cur = anim_name
	_anim.play(anim_name, blend)

func _apply_body() -> void:
	var squash := 1.0 - player.land * 0.18
	_body.scale = Vector2(player.face * (2.0 - squash), squash)
	_smear.scale = Vector2(1.0, 1.0)
	var blink := player.inv > 0.0 and player.dash_t <= 0.0 and player.flare_t <= 0.0 and not player.dead \
		and int(player.inv * 20.0) % 2 == 0
	_body.modulate.a = 0.55 if blink else 1.0
	_mat.set_shader_parameter("flash", 1.0 if _flash_t > 0.0 else 0.0)

## Cape (soft part, bible §5.7 p.7): hangs from the torso, trails behind the
## motion and lags with a spring; not keyed in the animations.
func _apply_cape(dt: float) -> void:
	var bones := [_skel.get_node("Hip/Torso/Cape1"), _skel.get_node("Hip/Torso/Cape1/Cape2"),
		_skel.get_node("Hip/Torso/Cape1/Cape2/Cape3")]
	var torso := _skel.get_node("Hip/Torso") as Bone2D
	var hip := _skel.get_node("Hip") as Bone2D
	var vx := player.velocity.x * player.face
	var trail := clampf(vx * 0.0012, -0.25, 0.55) + clampf(player.velocity.y * 0.0006, -0.25, 0.45)
	var sway := sin(_clock * 2.4) * 0.05
	var target := [trail + sway - (torso.rotation + hip.rotation) * 0.7, trail * 0.35 + sway * 0.8,
		trail * 0.3 + sway * 1.2]
	for i in 3:
		_cape[i] = lerpf(_cape[i], target[i], minf(1.0, dt * (9.0 - i * 2.0)))
		(bones[i] as Bone2D).rotation = _cape[i]

func _apply_glow() -> void:
	var fill := 0.0
	if player.amulet:
		fill = clampf(player.amulet.charge / maxf(player.amulet.ready_at(), 0.001), 0.0, 1.5)
	_glow.modulate = Color(GLOW_COLOR, 0.35 + 0.35 * fill)
	_glow.scale = Vector2.ONE * (0.22 + 0.16 * fill)

## Samples the weapon line over the last SMEAR_SPAN of progress by seeking the
## animation (deterministic: the pose is a function of progress). Only inside the
## strike's hit window, so the smear is always the arc in front of the hero.
func _sample_smear(anim_name: String, k: float, length: float) -> void:
	_smear_pts.clear()
	if not anim_name.begins_with("strike") or anim_name == "strike_down":
		return
	var win: Array = (Tune.get_value("blade") as Dictionary).get("win", [0.25, 0.7])
	if k < float(win[0]) - 0.1 or k > float(win[1]) + 0.1:
		return
	var weapon := _skel.get_node("Hip/Torso/ArmF/ForeF/HandF/WeaponF") as Bone2D
	var inv := _smear.get_global_transform().affine_inverse()
	for i in SMEAR_SAMPLES:
		var kk := clampf(k - SMEAR_SPAN * float(i) / float(SMEAR_SAMPLES - 1), 0.0, 1.0)
		_anim.seek(kk * length, true)
		var gt := weapon.get_global_transform()
		_smear_pts.append(inv * (gt * Vector2(WEAPON_TIP, 0.0)))
		_smear_pts.append(inv * (gt * Vector2(SMEAR_BASE, 0.0)))

func _draw_smear() -> void:
	var n := _smear_pts.size() / 2
	for i in n - 1:
		var a := 0.42 * (1.0 - float(i) / float(n - 1))
		var quad := PackedVector2Array([_smear_pts[i * 2], _smear_pts[i * 2 + 2], _smear_pts[i * 2 + 3], _smear_pts[i * 2 + 1]])
		_smear.draw_colored_polygon(quad, Color(SMEAR_COLOR, a))

## Dash ghosts (world space, from Player.ghosts) and the Flare breath ring.
func _draw_fx() -> void:
	var h := height_px / (Tune.f("camera_zoom") if Tune.data.has("camera_zoom") else 1.0)
	for gh: Dictionary in player.ghosts:
		var gp: Vector2 = gh.p
		var a := clampf(float(gh.t) * 1.4, 0.0, 1.0)
		_fx.draw_set_transform(gp + Vector2(0, -h * 0.45), 0.0, Vector2(0.3, 1.0))
		_fx.draw_circle(Vector2.ZERO, h * 0.5, Color(GHOST_COLOR, 0.22 * a))
		_fx.draw_circle(Vector2.ZERO, h * 0.36, Color(GHOST_COLOR, 0.25 * a))
	_fx.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	if player.flare_t > 0.0:
		var k := player.flare_t / maxf(Tune.f("flare_windup"), 0.01)
		_fx.draw_arc(_glow.global_position, 12.0 + 80.0 * k, 0.0, TAU, 40, Color(GLOW_COLOR, 0.9), 3.0)

func _on_hurt(_amount: float, _hit: Hit) -> void:
	_hurt_t = HURT_TIME
	_flash_t = FLASH_TIME
